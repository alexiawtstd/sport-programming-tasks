import sys

MOD = 10**9 + 7

data = sys.stdin.buffer.read().split()
if not data:
    sys.exit()

n = int(data[0])
k = int(data[1])

dp = [0] * (n + 1)
pref = [0] * (n + 1)

dp[0] = 1
pref[0] = 1

for i in range(1, n + 1):
    s = pref[i - 1]
    if i - k - 1 >= 0:
        s -= pref[i - k - 1]
    s %= MOD
    dp[i] = s
    pref[i] = (pref[i - 1] + dp[i]) % MOD

print(dp[n])
