import sys
 
data = list(map(int, sys.stdin.buffer.read().split()))
if not data:
    sys.exit()
 
t = data[0]
idx = 1
out = []
 
for _ in range(t):
    n = data[idx]
    x = data[idx + 1]
    idx += 2
    arr = data[idx:idx + n]
    idx += n
 
    ans = 0
    reachable = {1}
 
    for val in arr:
        if val == 1 or x % val != 0:
            continue
 
        new_reachable = set(reachable)
        for p in reachable:
            prod = p * val
            if prod <= x and x % prod == 0:
                new_reachable.add(prod)
 
        if x in new_reachable:
            ans += 1
            reachable = {1, val}
        else:
            reachable = new_reachable
 
    ans += 1
    out.append(str(ans))
 
sys.stdout.write("\n".join(out))
