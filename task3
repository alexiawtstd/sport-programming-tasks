import sys
 
nums = sys.stdin.read().strip().split()
 
n = int(nums[0])
m = int(nums[1])
vals = list(map(int, nums[2:]))
 
a = []
index = 0
for i in range(n):
    row = vals[index:index + m]
    a.append(row)
    index += m
 
dp = [[0] * m for _ in range(n)]
 
for i in range(n):
    for j in range(m):
        best = 0
        if i == 0 and j == 0:
            best = 0
        else:
            if i > 0:
                best = max(best, dp[i - 1][j])
            if j > 0:
                best = max(best, dp[i][j - 1])
            if i > 0 and j > 0:
                best = max(best, dp[i - 1][j - 1])
        dp[i][j] = a[i][j] + best
 
print(dp[n - 1][m - 1])
